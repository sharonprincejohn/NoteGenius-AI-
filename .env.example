# NoteGenius AI - Multi-Provider AI Configuration

# 1. Google Gemini API (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# 2. Groq Cloud API (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Active Provider: "Google Gemini" or "Groq Cloud"
AI_PROVIDER="Google Gemini"

